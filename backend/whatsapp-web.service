[Unit]
Description=WhatsApp Web App (FastAPI + neonize)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/whatsapp-web-app
ExecStart=/opt/whatsapp-web-app/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
Environment=WA_PORT=8000

[Install]
WantedBy=multi-user.target
